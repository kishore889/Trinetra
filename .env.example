# ==================================================
# TRINETRA — Environment Configuration
# ==================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ==================================================

# --------------------------------------------------
# APPLICATION
# --------------------------------------------------
APP_ENV=development
DEBUG=true
SECRET_KEY=CHANGE_ME_use_openssl_rand_hex_32_here

# --------------------------------------------------
# DATABASE
# --------------------------------------------------
# Format: postgresql://user:password@host:port/dbname
DATABASE_URL=postgresql://trinetra:trinetra_dev@localhost:5432/trinetra

# Separate test database to avoid overwriting dev data
TEST_DATABASE_URL=postgresql://trinetra:trinetra_dev@localhost:5432/trinetra_test

# --------------------------------------------------
# GOOGLE OAUTH 2.0
# --------------------------------------------------
# Obtain from: https://console.cloud.google.com/apis/credentials
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# --------------------------------------------------
# GOOGLE CLOUD (for Gmail Watch + Pub/Sub)
# --------------------------------------------------
GOOGLE_CLOUD_PROJECT=
# Format: projects/{project}/topics/{topic}
GOOGLE_PUBSUB_TOPIC=

# --------------------------------------------------
# GEMINI API
# --------------------------------------------------
# Used for explainability / natural language explanations only.
# TRINETRA does NOT use Gemini as the sole phishing classifier.
GEMINI_API_KEY=

# --------------------------------------------------
# THREAT INTELLIGENCE PROVIDERS (all optional)
# --------------------------------------------------
# TRINETRA functions without these; they enhance detection.
VIRUSTOTAL_API_KEY=
GOOGLE_SAFE_BROWSING_API_KEY=

# --------------------------------------------------
# RISK ENGINE WEIGHTS (must sum to 1.0)
# --------------------------------------------------
RISK_WEIGHT_CONTENT=0.25
RISK_WEIGHT_URL=0.30
RISK_WEIGHT_IDENTITY=0.20
RISK_WEIGHT_THREAT_INTEL=0.15
RISK_WEIGHT_GRAPH=0.10

# --------------------------------------------------
# RISK ENGINE DECISION THRESHOLDS (0.0 - 1.0)
# --------------------------------------------------
# Scores below WARN_THRESHOLD → ALLOW
# Scores between thresholds → WARN
# Scores above QUARANTINE_THRESHOLD → QUARANTINE
RISK_THRESHOLD_WARN=0.40
RISK_THRESHOLD_QUARANTINE=0.70

# --------------------------------------------------
# CORS
# --------------------------------------------------
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# --------------------------------------------------
# SECURITY
# --------------------------------------------------
ACCESS_TOKEN_EXPIRE_MINUTES=60
ALGORITHM=HS256

# --------------------------------------------------
# RATE LIMITING
# --------------------------------------------------
RATE_LIMIT_PER_MINUTE=60
