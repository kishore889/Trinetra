# ==================================================
# TRINETRA .gitignore
# ==================================================

# --- Environment & Secrets ---
.env
.env.local
.env.*.local
*.pem
*.key
*.p12
credentials.json
token.json

# --- Python ---
__pycache__/
*.py[cod]
*$py.class
*.so
.Python
build/
develop-eggs/
dist/
downloads/
eggs/
.eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
pip-wheel-metadata/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST
*.manifest
*.spec
pip-log.txt
pip-delete-this-directory.txt
htmlcov/
.tox/
.nox/
.coverage
.coverage.*
.cache
nosetests.xml
coverage.xml
*.cover
*.py,cover
.hypothesis/
.pytest_cache/
pytestdebug.log

# --- Virtual Environments ---
venv/
.venv/
ENV/
env/
env.bak/
venv.bak/

# --- IDE ---
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# --- Node / Frontend ---
node_modules/
frontend/dist/
frontend/build/
frontend/.next/
frontend/out/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# --- ML Models (large binary files) ---
models/*.pkl
models/*.joblib
models/*.h5
models/*.pt
models/*.bin
models/*.onnx
# Keep placeholder
!models/.gitkeep

# --- Data ---
data/*.csv
data/*.json
data/*.db
data/*.sqlite
# Keep placeholder
!data/.gitkeep

# --- Logs ---
logs/
*.log
*.log.*

# --- Database ---
*.sqlite3
*.db
postgres-data/

# --- Alembic ---
# Keep versions tracked, ignore __pycache__
backend/alembic/__pycache__/

# --- Docker ---
docker-data/

# --- OS ---
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini
